<div class="museum-site">

  <header class="museum-header">

    <div class="museum-logo">
      <div class="museum-logo-icon">
        <img src="/themes/custom/heritage_museum/images/logo-header.png" alt="Oriental Mindoro Heritage Museum logo">
      </div>

      <div>
        <div class="museum-name">ORIENTAL MINDORO</div>
        <div class="museum-subtitle">HERITAGE MUSEUM</div>
      </div>
    </div>


    <nav class="museum-nav">

      <a href="{{ path('<front>') }}" class="active">
        Home
      </a>

      <a href="/exhibits">
        Exhibits
      </a>

      <a href="/about">
        About
      </a>

      <a href="/visit">
        Visit
      </a>

      <a href="/contact">
        Contact
      </a>

    </nav>


    <a href="/exhibits" class="museum-button">
      <span>View All Exhibits</span>
      <span class="button-arrow">→</span>
    </a>

  </header>


  <main class="museum-home">


    <!-- HERO -->

    <section class="museum-hero">

      <div class="hero-content">

        <span class="hero-label">
          ORIENTAL MINDORO
        </span>

        <h1>
          Preserving Our Past,<br>
          Inspiring Our Future
        </h1>

        <p>
          Discover the rich cultural heritage, traditions,
          artistry, and stories of Oriental Mindoro.
        </p>


        <div class="hero-actions">

          <a href="/exhibits" class="primary-button">
            <span>Explore Exhibits</span>
            <span class="button-arrow">→</span>
          </a>

          <a href="/about" class="secondary-button">
            <span>Learn More</span>
            <span class="button-arrow">→</span>
          </a>

        </div>

      </div>


      <div class="hero-image">

        <div class="hero-image-placeholder">

          <img
            src="/themes/custom/heritage_museum/images/logo.jpg"
            alt="Oriental Mindoro Heritage Museum logo"
          >

        </div>

      </div>

    </section>



    <!-- INTRO -->

    <section class="museum-intro">

      <span class="section-label">
        OUR HERITAGE
      </span>

      <h2>
        Stories That Connect<br>
        Generations
      </h2>

      <p>
        The Oriental Mindoro Heritage Museum celebrates the
        traditions, crafts, communities, and history that have
        shaped the province through generations.
      </p>

    </section>



    <!-- FEATURED EXHIBITS -->

    <section class="featured-exhibits">

      <div class="section-heading">

        <div>

          <span class="section-label">
            FEATURED
          </span>

          <h2>
            Featured Exhibits
          </h2>

        </div>


        <a href="/exhibits" class="text-link">
          <span>View all exhibits</span>
          <span class="button-arrow">→</span>
        </a>

      </div>



      <div class="exhibit-grid">

  {% for exhibit in featured_exhibits %}
    <a href="{{ exhibit.url }}" class="featured-exhibit-card">

      <div class="featured-exhibit-image">
        {% if exhibit.image_url %}
          <img src="{{ exhibit.image_url }}" alt="{{ exhibit.title }}">
        {% endif %}
      </div>

      <h3>{{ exhibit.title }}</h3>

    </a>
  {% endfor %}

</div>

    </section>

  </main>



  <!-- FOOTER -->

  <footer class="museum-footer">

    <div>

      <strong>
        ORIENTAL MINDORO
      </strong>

      <br>

      HERITAGE MUSEUM

    </div>


    <div class="footer-tagline">

      Preserving Our Past, Inspiring Our Future

    </div>


    <div>

      © {{ "now"|date("Y") }}

    </div>

  </footer>


</div>
