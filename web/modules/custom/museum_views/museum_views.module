<?php

/**
 * @file
 * Main module file for Museum Views.
 */

/**
 * Implements hook_preprocess_node().
 */
function museum_views_preprocess_node(array &$variables) {
  $node = $variables['node'];

  // Only count full-page views of Exhibit content.
  if ($node->bundle() !== 'exhibit' || $variables['view_mode'] !== 'full') {
    return;
  }

  $nid = (int) $node->id();

  // Make sure this full node render is not cached, so each page visit
  // can be counted.
  $variables['#cache']['max-age'] = 0;

  $database = \Drupal::database();

  // Add one view for this exhibit.
  $database->merge('museum_exhibit_views')
    ->key('nid', $nid)
    ->fields([
      'view_count' => 1,
    ])
    ->expression('view_count', 'view_count + 1')
    ->execute();

  // Get the updated count.
  $count = $database->select('museum_exhibit_views', 'v')
    ->fields('v', ['view_count'])
    ->condition('nid', $nid)
    ->execute()
    ->fetchField();

  $variables['exhibit_view_count'] = (int) $count;
}

/**
 * Implements hook_preprocess_page().
 */
function museum_views_preprocess_page__front(array &$variables) {
  // Do not cache the homepage because Featured Exhibits depend on live view counts.
  $variables['#cache']['max-age'] = 0;

  $database = \Drupal::database();

  $query = $database->select('museum_exhibit_views', 'v');
  $query->join('node_field_data', 'n', 'n.nid = v.nid');

  $query->fields('v', ['nid', 'view_count']);
  $query->condition('n.type', 'exhibit');
  $query->condition('n.status', 1);
  $query->orderBy('v.view_count', 'DESC');
  $query->orderBy('v.nid', 'DESC');
  $query->range(0, 3);

  $results = $query->execute()->fetchAll();

  $featured_exhibits = [];

  foreach ($results as $result) {
    $node = \Drupal\node\Entity\Node::load($result->nid);

    if ($node) {
      $featured_exhibits[] = [
        'nid' => $node->id(),
        'title' => $node->label(),
        'url' => $node->toUrl()->toString(),
        'image_url' => '',
      ];

      if (!$node->get('field_exhibit_image')->isEmpty()) {
        $file = $node->get('field_exhibit_image')->entity;

        if ($file) {
          $featured_exhibits[array_key_last($featured_exhibits)]['image_url'] =
            \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        }
      }
    }
  }

  $variables['featured_exhibits'] = $featured_exhibits;
}
